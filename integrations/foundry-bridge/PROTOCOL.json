{
  "protocol_version": 1,
  "command_required": [
    "protocol_version",
    "command_id",
    "operations"
  ],
  "optional_concurrency": [
    "scene_id",
    "expected_revision",
    "dry_run",
    "world_id"
  ],
  "operations": {
    "snapshot": {},
    "ping": {},
    "set_3d_environment": {
      "values": "allow-listed levels-3d-preview keys"
    },
    "scene_update": {
      "changes": "safe Foundry Scene dotted paths"
    },
    "embedded_create": {
      "document": "allow-listed document type",
      "data": "object or array"
    },
    "embedded_update": {
      "document": "allow-listed document type",
      "updates": "objects with _id"
    },
    "embedded_delete": {
      "document": "allow-listed document type",
      "ids": "array"
    },
    "tile_set_model3d": {
      "tile_id": "string",
      "foundry_path": "string",
      "color": "#ffffff optional"
    },
    "asset_upload": {
      "asset_file": "relative path under assets/incoming OR file_b64",
      "relative_dir": "module storage dir"
    },
    "inspect_3d_scene": {},
    "search_3d_assets": {
      "query": "string",
      "limit": "1..200 optional",
      "roots": "safe module asset roots optional",
      "max_depth": "0..8 optional"
    },
    "set_3d_camera": {
      "position": "{x,y,z} optional",
      "target": "{x,y,z} optional",
      "save_as_initial": "boolean optional"
    },
    "capture_3d_view": {
      "position": "{x,y,z} optional",
      "target": "{x,y,z} optional",
      "format": "webp|png",
      "quality": "0.1..1",
      "restore_camera": "boolean default true"
    },
    "apply_semantic_objects": {
      "build_id": "optional string",
      "objects": "array of {document, semantic_id, data, build_id?, provenance?, classification?}"
    },
    "validate_scene_manifest": {
      "expected_manifest": "{semantic_ids?:[], counts?:{}, allow_unexpected?:boolean}"
    },
    "delete_semantic_objects": {
      "semantic_ids": "array of stable flags.acq.semantic_id values"
    },
    "reload_3d_scene": {
      "dry_run": "boolean optional"
    },
    "resize_scene": {
      "width": "scene width in pixels, safe range 1000-100000",
      "height": "scene height in pixels, safe range 1000-100000",
      "padding": "optional 0-1",
      "result": "before/after dimensions; supports expected_revision at command level"
    }
  },
  "direct_rpc": {
    "endpoint": "POST /rpc on loopback agent",
    "purpose": "synchronous MCP-to-Foundry command path; bypasses Drive command files",
    "timeout_seconds": "1..120",
    "security": "agent remains loopback-only and module remains GM-only"
  }
}
